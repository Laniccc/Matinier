{
  "$defs": {
    "JsonRpcError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JsonRpcError",
      "type": "object"
    },
    "JsonRpcErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/JsonRpcError"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        }
      },
      "required": [
        "id",
        "error"
      ],
      "title": "JsonRpcErrorResponse",
      "type": "object"
    },
    "JsonRpcRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Id"
        },
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "method": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Method",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "method"
      ],
      "title": "JsonRpcRequest",
      "type": "object"
    },
    "JsonRpcResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Id"
        },
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "title": "Jsonrpc",
          "type": "string"
        },
        "result": {
          "title": "Result"
        }
      },
      "required": [
        "id",
        "result"
      ],
      "title": "JsonRpcResponse",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/JsonRpcRequest"
    },
    {
      "$ref": "#/$defs/JsonRpcResponse"
    },
    {
      "$ref": "#/$defs/JsonRpcErrorResponse"
    }
  ]
}
