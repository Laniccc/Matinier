# Deployment boundary. localhost values below are development defaults only.
APP_ENV=development
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FFMPEG_BIN=ffmpeg

# LiveKit local development defaults. devkey/secret are the documented
# livekit-server --dev pair and MUST NOT be reused in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM_NAME=live-caption
LIVEKIT_AGENT_NAME=live-caption-agent
LIVEKIT_CONNECT_TIMEOUT_SECONDS=15
FFMPEG_START_TIMEOUT_SECONDS=10
HLS_FIRST_FRAME_TIMEOUT_SECONDS=15
HLS_STOP_TIMEOUT_SECONDS=5
REMOTE_MEDIA_CONNECT_TIMEOUT_SECONDS=10
REMOTE_MEDIA_READ_TIMEOUT_SECONDS=20
REMOTE_MEDIA_MAX_REDIRECTS=3
MAX_REMOTE_STREAM_DURATION_SECONDS=14400

# Low-frequency Worker -> API source cleanup control plane. This token is a
# local example only; replace it in every non-development environment.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_CONTROL_TOKEN=replace-with-a-random-internal-token
INTERNAL_CONTROL_TIMEOUT_SECONDS=10

# Stage 2 Bailian real-time ASR. Leave credentials empty for Stage 0/1 or
# credential-free tests; the Worker validates them when a replay track starts.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Existing environments may use BAILIAN_WORKSPACE_ID instead. Do not set both.
DASHSCOPE_REGION=beijing
DASHSCOPE_WEBSOCKET_URL=
BAILIAN_ASR_MODEL=fun-asr-realtime
BAILIAN_TRANSLATION_MODEL=qwen3.5-livetranslate-flash-realtime
DASHSCOPE_TRANSLATION_WEBSOCKET_URL=
# Empty means direct WebSocket connections. Set an explicit proxy URL only
# when the deployment requires one; ambient OS/process proxies are ignored.
DASHSCOPE_WEBSOCKET_PROXY_URL=
ASR_CHUNK_DURATION_MS=100
ASR_QUEUE_MAX_CHUNKS=20
ASR_START_TIMEOUT_SECONDS=10
ASR_FINISH_TIMEOUT_SECONDS=15
ASR_STARTUP_RETRIES=1
TRANSLATION_QUEUE_MAX_CHUNKS=20
TRANSLATION_START_TIMEOUT_SECONDS=10
TRANSLATION_FINISH_TIMEOUT_SECONDS=20

# Worker data-plane mode. Production is the only default that calls Bailian.
WORKER_RUNTIME_MODE=production
TRANSPORT_QUEUE_MAX_FRAMES=100
TRANSPORT_CONSUMER_DELAY_MS=0
FAKE_PROVIDER_CHUNKS_PER_SEGMENT=3
FAKE_PROVIDER_SEND_DELAY_MS=0
FAKE_PROVIDER_DUPLICATE_FINAL=false
FAKE_PROVIDER_STALE_PARTIAL=false
FAKE_ASR_FAIL_AFTER_CHUNKS=
FAKE_TRANSLATION_FAIL_AFTER_CHUNKS=
FAKE_ASR_TIMEOUT_ON_FINISH=false
FAKE_TRANSLATION_TIMEOUT_ON_FINISH=false

# Stage 5 DeepSeek post-processing. The key remains optional until a user
# explicitly generates a processed script; it is never exposed to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_INPUT_CHARS=12000
DEEPSEEK_MAX_SEGMENTS_PER_CHUNK=40
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

# External task integration for the private meeting Assistant. `disabled` is the
# safe default; `fake` is development-only. Project is optional and server-owned.
TASK_SYSTEM_PROVIDER=disabled
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_DEFAULT_PROJECT_ID=
LINEAR_REQUEST_TIMEOUT_SECONDS=10
LINEAR_MAX_SEARCH_RESULTS=20

# Private meeting Assistant. Keep disabled unless the meeting sidecar and its
# model/task providers are intentionally enabled. Use a dedicated Linear Team
# for demos so one generated Issue can be inspected and removed safely.
ASSISTANT_ENABLED=false
ASSISTANT_FAST_TIMEOUT_SECONDS=5
ASSISTANT_FAST_MAX_MODEL_ROUNDS=2
ASSISTANT_FAST_MAX_PARALLEL_READ_TOOLS=2
ASSISTANT_GRANT_MAX_TTL_SECONDS=900
ASSISTANT_ACTION_MAX_STEPS=20
ASSISTANT_ACTION_MAX_MODEL_CALLS=16
ASSISTANT_ACTION_MAX_PLANNING_ROUNDS=4
ASSISTANT_ACTION_CONCURRENCY=3
ASSISTANT_SUBAGENTS_PER_RUN=3
ASSISTANT_SUBAGENT_GLOBAL_CONCURRENCY=6
ASSISTANT_TOOL_TIMEOUT_SECONDS=15
ASSISTANT_RECONCILIATION_DELAYS_SECONDS=1,3,10
MEETING_STATE_POLL_INTERVAL_MS=400
MEETING_STATE_BATCH_SEGMENTS=10
MEETING_STATE_BATCH_TRIGGER_CHARS=2000
MEETING_STATE_MAX_INPUT_CHARS=12000
MEETING_STATE_MAX_BATCH_WAIT_SECONDS=4
MEETING_STATE_SCAN_OVERLAP_SECONDS=2
MEETING_STATE_STALE_AFTER_SECONDS=10
MEETING_STATE_CONCURRENCY=2
MEETING_STATE_PRIORITY_BURST=2
MEETING_STATE_RETRY_DELAYS_SECONDS=1,2,5,10,30

# Local third-party plugin framework. Mutating /api/plugins operations require
# this admin token; generate a random value locally and never commit it.
PLUGIN_FRAMEWORK_ENABLED=true
PLUGIN_ADMIN_TOKEN=
PLUGIN_CONTAINER_RUNTIME=docker
# Development escape hatch only. Production settings reject unsigned packages.
PLUGIN_ALLOW_UNSIGNED=false
# Development-only local build switch. Production settings always reject true.
PLUGIN_BUILTIN_BUILD_ENABLED=false
# Must be an absolute platform-local path outside this repository. Leave this
# line commented to use the operating-system application-data default.
# PLUGIN_BUILTIN_WORK_DIR=C:/Users/your-name/AppData/Local/Matinier/plugin-builtins
PLUGIN_PACKAGE_MAX_COMPRESSED_BYTES=536870912
PLUGIN_PACKAGE_MAX_UNCOMPRESSED_BYTES=2147483648
PLUGIN_PACKAGE_MAX_ENTRIES=2000
PLUGIN_RPC_MAX_LINE_BYTES=262144
PLUGIN_RPC_MAX_MESSAGE_BYTES=262144
PLUGIN_RPC_TIMEOUT_SECONDS=30
PLUGIN_MODEL_MAX_CONCURRENCY=2
PLUGIN_MODEL_MAX_INPUT_CHARS=32000
PLUGIN_MODEL_MAX_OUTPUT_TOKENS=4096
PLUGIN_DOCUMENT_MAX_BYTES=196608
PLUGIN_DELIVERY_MAX_PAGE_ITEMS=100
PLUGIN_CONTAINER_MEMORY_MB=256
PLUGIN_CONTAINER_CPU_COUNT=0.5
PLUGIN_CONTAINER_PID_LIMIT=64
PLUGIN_CONTAINER_TMPFS_MB=64
PLUGIN_CRASH_LOOP_MAX_RESTARTS=5
PLUGIN_CRASH_LOOP_WINDOW_SECONDS=60
PLUGIN_SHUTDOWN_TIMEOUT_SECONDS=10
MEDIA_EVENT_PROJECTOR_POLL_INTERVAL_MS=500
MEDIA_EVENT_PROJECTOR_BATCH_SIZE=100
MEDIA_EVENT_PROJECTOR_SCAN_SESSION_LIMIT=100

# Relative DATA_DIR values are resolved from the project root, never the cwd.
DATA_DIR=backend/data
# Leave empty to use the normalized absolute DATA_DIR/live_caption.db URL.
DATABASE_URL=
LOG_LEVEL=INFO
# Provider raw responses may contain full transcripts. Keep disabled unless
# diagnosing a provider protocol problem in a controlled local environment.
LOG_PROVIDER_PAYLOADS=false
